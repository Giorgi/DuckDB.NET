<Project DefaultTargets="DownloadNatives">

  <!-- Releases (since DuckDB 2.0) and nightly builds alike: download the shared-libs tarball and extract it -->
  <Target Name="DownloadNatives"
          Condition="!Exists('$(MSBuildProjectDirectory)\obj\runtimes\$(Rid)\native')">
    <PropertyGroup>
      <RidDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'obj', 'runtimes', '$(Rid)'))</RidDirectory>
      <NativeTarPath>$(RidDirectory)native.tar.gz</NativeTarPath>
    </PropertyGroup>
    <MakeDir Directories="$(RidDirectory)native" />
    <Delete Files="$(NativeTarPath)" Condition="Exists('$(NativeTarPath)')" ContinueOnError="true"/>
    <DownloadFile
            DestinationFolder="$(RidDirectory)"
            SourceUrl="$(LibUrl)"
            Retries="5"
            RetryDelayMilliseconds="1000"
            DestinationFileName="native.tar.gz"/>
    <!-- Relative paths: GNU tar (e.g. Git for Windows) reads "C:\..." as a remote host -->
    <Exec Command="tar -xzf native.tar.gz -C native" WorkingDirectory="$(RidDirectory)" />
    <Delete Files="$(NativeTarPath)"/>
  </Target>

</Project>
